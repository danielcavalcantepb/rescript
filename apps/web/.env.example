# Copie para .env.local e preencha (nunca commitar .env.local)
# Public (browser) — publishable key only
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cakto Billing Gateway Adapter (server-only). Map each Rescript price UUID
# to an offer already configured in Cakto; never expose these values to Vite.
CAP_BILLING_GATEWAY=cakto
CAKTO_API_CLIENT_ID=
CAKTO_API_CLIENT_SECRET=
CAKTO_WEBHOOK_SIGNING_SECRET=
CAKTO_OFFER_BY_PRICE_ID={"rescript-price-uuid":"cakto-offer-id"}

# Server-only (never prefix with VITE_) — Catalog Phase 3B SQL transactions
# SUPABASE_DB_URL=
# DATABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # admin/tests only — never ship to the browser
